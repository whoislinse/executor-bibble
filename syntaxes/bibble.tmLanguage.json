{
  "name": "Executor Bibble (Luau)",
  "scopeName": "source.bibble",
  "patterns": [{ "include": "#all" }],
  "repository": {
    "all": {
      "patterns": [
        { "include": "#shebang" },
        { "include": "#comment" },
        { "include": "#string-interp" },
        { "include": "#string" },
        { "include": "#number" },
        { "include": "#attribute" },
        { "include": "#declaration" },
        { "include": "#keyword" },
        { "include": "#type" },
        { "include": "#call" },
        { "include": "#name" }
      ]
    },
    "shebang": {
      "match": "\\A#!.*",
      "name": "comment.line.shebang.bibble"
    },
    "comment": {
      "patterns": [
        { "match": "--\\[=*\\]", "name": "comment.block.empty.bibble" },
        {
          "begin": "--\\[(=*)\\[",
          "end": "\\]\\1\\]",
          "name": "comment.block.bibble"
        },
        { "match": "--.*", "name": "comment.line.double-dash.bibble" }
      ]
    },
    "string-interp": {
      "begin": "`",
      "end": "`",
      "name": "string.interpolated.bibble",
      "patterns": [
        {
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.bibble" } },
          "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.bibble" } },
          "patterns": [{ "include": "#all" }]
        }
      ]
    },
    "string": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.bibble",
          "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.bibble" }]
        },
        {
          "begin": "'",
          "end": "'",
          "name": "string.quoted.single.bibble",
          "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.bibble" }]
        },
        {
          "begin": "\\[(=*)\\[",
          "end": "\\]\\1\\]",
          "name": "string.raw.bibble"
        }
      ]
    },
    "number": {
      "match": "\\b0[xX][0-9a-fA-F_]+(\\.[0-9a-fA-F_]*)?([pP][-+]?\\d+)?|\\b\\d[\\d_]*(\\.\\d[\\d_]*)?([eE][-+]?\\d+)?",
      "name": "constant.numeric.bibble"
    },
    "attribute": {
      "match": "@[A-Za-z_][\\w.]*",
      "name": "meta.attribute.bibble"
    },
    "declaration": {
      "patterns": [
        {
          "match": "^\\s*(?:export\\s+)?(?:local\\s+)?function\\s+([A-Za-z_][\\w.:]*)",
          "captures": { "1": { "name": "entity.name.function.bibble" } }
        },
        {
          "match": "^\\s*(?:export\\s+)?type\\s+([A-Za-z_]\\w*)",
          "captures": { "1": { "name": "entity.name.type.bibble" } }
        },
        {
          "match": "\\b([A-Za-z_]\\w*)\\s*=\\s*function",
          "captures": { "1": { "name": "entity.name.function.bibble" } }
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "match": "\\b(and|break|continue|do|else|elseif|end|export|false|for|function|if|in|local|nil|not|or|repeat|return|then|true|type|until|while)\\b",
          "name": "keyword.control.bibble"
        },
        { "match": "\\bself\\b", "name": "variable.language.self.bibble" },
        {
          "match": "(\\+=|-=|\\*=|/=|//=|%=|\\^=|\\.\\.=|==|~=|<=|>=|<<|>>|//|\\.\\.)",
          "name": "keyword.operator.assignment.bibble"
        },
        {
          "match": "(\\+|-|\\*|/|%|\\^|#|<|>|=|~|\\.|\\,|;|:|::|\\?|\\||&)",
          "name": "keyword.operator.bibble"
        }
      ]
    },
    "type": {
      "match": "\\b(nil|boolean|number|string|thread|userdata|buffer|any|unknown|never)\\b(?=\\s*[,>)\\]=\\s])",
      "name": "support.type.primitive.bibble"
    },
    "call": {
      "begin": "([A-Za-z_][\\w.]*)(:)\\s*([A-Za-z_]\\w*)?\\s*(?=\\()",
      "beginCaptures": {
        "1": { "name": "entity.name.type.bibble" },
        "2": { "name": "punctuation.separator.colon.bibble" },
        "3": { "name": "entity.name.function.bibble" }
      },
      "end": "(?<=\\))",
      "patterns": [{ "include": "#all" }]
    },
    "name": {
      "patterns": [
        {
          "match": "\\b(Drawing|DrawFont|WebSocket|VoltSignal|VoltConnection|LuaStateProxy|RakNetPacket|Signal)\\b",
          "name": "support.class.executor.bibble"
        },
        {
          "match": "\\b(bit|cache|coroutine|crypt|debug|math|oth|raknet|string|table|task|utf8|buffer|os)\\b",
          "name": "support.library.bibble"
        },
        {
          "match": "\\b(game|workspace|script|shared|Instance|Enum|Color3|Vector2|Vector3|CFrame|UDim|UDim2|TweenInfo|Random|DateTime|Ray|Rect|Region3|Font|NumberRange|NumberSequence|BrickColor)\\b",
          "name": "support.class.rbx.bibble"
        },
        { "match": "\\b[A-Z][A-Z0-9_]{2,}\\b", "name": "constant.other.bibble" },
        { "match": "\\b[A-Za-z_]\\w*\\b", "name": "variable.other.bibble" }
      ]
    }
  }
}
